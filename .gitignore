cat > .gitignore <<'EOF'
# Secrets and environment files
.env
.env.*
!.env.example
!.env.*.example
backend/.env
frontend/.env.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.python-version
.venv/
venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
dist/
.vite/
coverage/
*.tsbuildinfo

# Build and deployment
build/
.next/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDEs and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Audio test outputs
aria.wav
*.wav
EOF
