# Backend-only. Copy to backend/.env; never put secrets in VITE_* variables.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Abuse protection (comma-separated exact Origin values).
MAX_CONCURRENT_SESSIONS=5
MAX_CALL_DURATION_SECONDS=600
CALL_IDLE_TIMEOUT_SECONDS=120
ALLOWED_WS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HTTP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Temporary demo identity (in-memory; restart clears all identities).
DEMO_SESSION_IDLE_TIMEOUT_SECONDS=1800
PENDING_ACTION_TTL_SECONDS=300
